    "shells": {
      "bash": {
        "command": "ls",
        "aliases": ["dir", "vdir"],
        "flags": {
          "-l": "long format",
          "-a": "include hidden files",
          "-h": "human-readable sizes"
        }
      },
      "powershell": {
        "command": "Get-ChildItem",
        "aliases": ["ls", "dir", "gci"],
        "flags": {
          "-Force": "include hidden files",
          "-Recurse": "list recursively"
        }
      }
    }
  },

