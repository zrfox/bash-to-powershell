[
  {
    "id": "list-directory",
    "description": "List directory contents",
    "shells": {
      "bash": {
        "command": "ls",
        "aliases": ["dir", "vdir"]
      },
      "powershell": {
        "command": "Get-ChildItem",
        "aliases": ["ls", "dir", "gci"]
      }
    },
    "flags": [
      {
        "id": "all-files",
        "description": "Include hidden entries",
        "shells": {
          "bash": ["-a", "--all"],
          "powershell": ["-Force"]
        }
      },
      {
        "id": "long-format",
        "description": "Long listing format",
        "shells": {
          "bash": ["-l"]
        }
      },
      {
        "id": "human-readable",
        "description": "Print sizes in human readable units",
        "shells": {
          "bash": ["-h", "--human-readable"]
        }
      },
      {
        "id": "recursive",
        "description": "Recurse into subdirectories",
        "shells": {
          "bash": ["-R", "--recursive"],
          "powershell": ["-Recurse"]
        }
      },
      {
        "id": "sort-time",
        "description": "Sort by modification time",
        "shells": {
          "bash": ["-t"]
        }
      },
      {
        "id": "reverse-order",
        "description": "Reverse the listing order",
        "shells": {
          "bash": ["-r", "--reverse"]
        }
      },
      {
        "id": "directories-only",
        "description": "List directories only",
        "shells": {
          "powershell": ["-Directory"]
        }
      },
      {
        "id": "files-only",
        "description": "List files only",
        "shells": {
          "powershell": ["-File"]
        }
      },
      {
        "id": "include",
        "description": "Include only matching items",
        "shells": {
          "powershell": ["-Include"]
        }
      },
      {
        "id": "exclude",
        "description": "Skip matching items",
        "shells": {
          "powershell": ["-Exclude"]
        }
      }
    ]
  },

  {
